// BIND9 Options - DNS Master
// DNS Web Manager - Production Configuration

options {
    directory "/var/cache/bind";

    // Disable recursion - this is an authoritative server only
    recursion no;

    // Allow queries from Docker networks and localhost
    allow-query {
        localhost;
        172.16.0.0/12;  // All Docker bridge networks
        172.25.0.0/16;  // DNS network (IPs fixos)
        10.0.0.0/8;     // Alternative Docker networks
    };

    // Allow zone transfers from slave
    allow-transfer {
        172.16.0.0/12;  // All Docker bridge networks
        172.25.0.11;    // dns-slave IP fixo
    };

    // Notify slave when zones change
    notify yes;
    also-notify { 172.25.0.11; };  // dns-slave IP fixo

    // Listen on all interfaces
    listen-on { any; };
    listen-on-v6 { any; };

    // DNSSEC settings
    dnssec-validation auto;

    // Query logging (useful for debugging)
    querylog yes;

    // Version hiding (security)
    version "DNS Web Manager";

    // Reduce response size for better performance
    minimal-responses yes;
};

// Logging configuration
logging {
    channel default_log {
        file "/var/log/named/named.log" versions 3 size 5m;
        severity info;
        print-time yes;
        print-severity yes;
        print-category yes;
    };

    channel query_log {
        file "/var/log/named/query.log" versions 3 size 10m;
        severity info;
        print-time yes;
    };

    channel security_log {
        file "/var/log/named/security.log" versions 3 size 5m;
        severity info;
        print-time yes;
        print-severity yes;
    };

    category default { default_log; };
    category queries { query_log; };
    category security { security_log; };
    category xfer-in { default_log; };
    category xfer-out { default_log; };
    category notify { default_log; };
};
