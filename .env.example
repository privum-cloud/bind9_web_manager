# ============================================
# PRIVUM DNS Manager - Environment Configuration
# ============================================
# Copy to .env and customize: cp .env.example .env
# Or use the installer: sudo ./install-master.sh
# ============================================

# ============================================
# SECURITY (REQUIRED - Change in production!)
# ============================================
# Generate with: python3 -c "import secrets; print(secrets.token_hex(32))"
FLASK_SECRET_KEY=

# Environment mode: production or development
FLASK_ENV=production

# ============================================
# CORS Configuration
# ============================================
# Comma-separated list of allowed origins
# Leave empty to use defaults (localhost:3000, localhost:5173)
# Example: CORS_ORIGINS=https://dns.example.com,https://admin.example.com
CORS_ORIGINS=

# ============================================
# DNS Configuration
# ============================================
# DNS Master hostname (usually localhost on master server)
DNS_MASTER_HOST=localhost

# DNS ports (53 for production, 5300 for development/WSL2)
DNS_MASTER_PORT=53

# Path to zone files (auto-detected if not set)
# Ubuntu/Debian: /var/lib/bind/zones
# RHEL/Rocky: /var/named/zones
# ZONES_PATH=

# Path to RNDC key (auto-detected if not set)
# RNDC_KEY_PATH=

# Path to named.conf.local (auto-detected if not set)
# NAMED_CONF_LOCAL=

# ============================================
# Backup Configuration
# ============================================
BACKUP_PATH=/opt/dns-manager/backups

# Retention policies (number of backups to keep)
RETENTION_DAILY=7
RETENTION_WEEKLY=4
RETENTION_MONTHLY=12

# ============================================
# SSO Configuration (Optional)
# ============================================
# Enable Keycloak SSO integration
KEYCLOAK_ENABLED=false

# Keycloak server settings
# KEYCLOAK_SERVER_URL=https://keycloak.example.com
# KEYCLOAK_REALM=dns-manager
# KEYCLOAK_CLIENT_ID=dns-web-manager

# Allow local admin login when SSO is enabled
LOCAL_ADMIN_ENABLED=true

# Group to role mapping (JSON format)
# KEYCLOAK_GROUP_MAPPING={"dns-admin":"admin","dns-operator":"operator","dns-viewer":"viewer"}

# ============================================
# Database Configuration (Optional)
# ============================================
# Default: SQLite at /opt/dns-manager/data/dns_manager.db
# For PostgreSQL: DATABASE_URL=postgresql://user:pass@host:5432/dbname
# DATABASE_URL=

# ============================================
# Rate Limiting (Optional)
# ============================================
# Storage for rate limiter (default: memory://)
# For Redis: redis://localhost:6379
# RATELIMIT_STORAGE_URI=memory://

# ============================================
# Timezone
# ============================================
TZ=UTC
